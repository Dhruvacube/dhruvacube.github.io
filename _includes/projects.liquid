<div class="col" style="padding-bottom: 2rem;">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" style="text-decoration: none; color: inherit; display: block;">
    <div class="pf-card" style="background: var(--global-card-bg-color); border-radius: 1.4rem; padding: 1.4rem; display: flex; flex-direction: column; min-height: 26rem; transition: transform 0.2s ease; border: none;">
      
      <div class="pf-art" style="flex: 1; display: grid; place-items: center; font: 800 clamp(4rem, 10vw, 6.5rem) 'Bricolage Grotesque', sans-serif; color: var(--global-theme-color); letter-spacing: -0.05em; padding: 2rem 0;">
        {% if project.art %}
          {{ project.art }}
        {% elsif project.title %}
          {{ project.title | slice: 0, 3 | upcase }}
        {% endif %}
      </div>

      <div class="pf-card-body" style="padding: 0; display: flex; flex-direction: column;">
        <h3 style="font-family: 'Bricolage Grotesque', sans-serif; font-size: 1.5rem; font-weight: 700; margin: 0 0 0.5rem; color: var(--global-text-color); letter-spacing: -0.03em;">{{ project.title }}</h3>
        <p style="font-family: 'Instrument Sans', sans-serif; font-size: 1rem; color: var(--global-text-color-light); margin: 0 0 1rem; line-height: 1.5;">{{ project.description }}</p>
        
        <div class="row ml-1 mr-1 p-0">
          {% if project.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
              </div>
              {% if project.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ project.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </a>
</div>
